# Copy this file to ".env" and fill in what you need. Everything is optional for local development.

PORT=3000

# --- Security (REQUIRED in production) ---
# Any long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# --- Database ---
# Leave DATABASE_URL empty to use a local SQLite file (zero setup).
# Set it to use PostgreSQL (production): postgres://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=
SQLITE_PATH=./data/wordforge.db

# --- AI (optional; without a key the game uses its built-in word bank) ---
# Set ONE of the keys below. The provider is detected automatically.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional overrides. AI_PROVIDER can be gemini | anthropic | openai | off
AI_PROVIDER=
# Model ids change often - check your provider's docs if you get a 404 error.
# Defaults: gemini -> gemini-3.1-flash-lite, anthropic -> claude-haiku-5-5. OpenAI needs AI_MODEL set.
AI_MODEL=

# --- Deployment behind a proxy / load balancer (Cloud Run, AWS ALB, Render...) ---
# Set to 1 so rate limiting uses the real client IP from X-Forwarded-For.
TRUST_PROXY=
